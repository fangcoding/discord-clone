# Copy this file to `.env.local` and replace the placeholder values.
# Find both values in the Supabase dashboard: Project Settings → API.
#
# `.env.local` is gitignored, so your real keys never get committed.
# Without these values the UI still renders using the local fallback data.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
